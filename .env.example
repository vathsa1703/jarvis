# Copy this file to .env and fill in what you need.

# ---- Brain -------------------------------------------------------------
# groq   = fast and smart, free key from https://console.groq.com/keys
# gemini = free key from https://aistudio.google.com/apikey (low free limits)
# ollama = fully local and private, no key, slower on this PC
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# qwen2.5:3b suits 8 GB of RAM. Run: ollama pull qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434/v1

# Any other OpenAI-compatible server: set LLM_PROVIDER=custom
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# ---- Server ------------------------------------------------------------
PORT=3000

# ---- Files -------------------------------------------------------------
# The only folder the file tools can read and write. Default: jarvis/data/workspace
# JARVIS_FILES_DIR=C:\Users\you\Documents\jarvis

# ---- News --------------------------------------------------------------
# Comma-separated RSS feed URLs
# NEWS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml,https://techcrunch.com/feed/

# ---- Gmail (optional, see README) --------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Claude Code -------------------------------------------------------
# Permission mode for background ("headless") runs.
# "default" cannot edit files, because nobody is there to approve the prompts.
# "acceptEdits" lets background runs edit files without asking.
CLAUDE_HEADLESS_PERMISSION_MODE=default
